<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="tgdesk.exe"
        Arguments=""
        InstallLocation="C:\Program Files\tgdesk\tgdesk">
    </Installer>
    <PackageInformation
        PackageName="tgdesk"
        PackageDisplayName="tgdesk"
        PublisherName="CN=tgdesk"
        PublisherDisplayName="tgdesk"
        Version="0.1.0.0"
        PackageDescription="Telegram media downloader and browser powered by tdl">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.tgdesk.app"
                Description="Telegram media downloader and browser powered by tdl"
                DisplayName="tgdesk"
                ExecutableName="tgdesk.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>tgdesk</DisplayName>
            <PublisherDisplayName>tgdesk</PublisherDisplayName>
            <Description>Telegram media downloader and browser powered by tdl</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="tgdesk.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
